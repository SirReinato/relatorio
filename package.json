{
  "name": "relatorio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "graphify": "./bin/graphify.cjs"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"api,spa\" -c \"yellow.bold,cyan.bold\" \"npm:api:dev\" \"npm:dev:spa\"",
    "dev:spa": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api:dev": "node --env-file-if-exists=.env api/server.js",
    "api:start": "node --env-file-if-exists=.env api/server.js",
    "lint": "eslint .",
    "test": "playwright test",
    "test:api": "node --test tests/api/*.test.js",
    "test:ui": "playwright test --ui",
    "graphify": "graphify update ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "ajv": "^8.20.0",
    "docx": "^9.15.3",
    "fastify": "^5.12.8",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^10.0.7",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "graphify": "^1.0.0",
    "vite": "^6.4.5"
  }
}
