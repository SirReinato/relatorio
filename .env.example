# Variáveis de ambiente públicas (client-side)
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development

# API (server-side). Copie para .env localmente; nunca use prefixo VITE_ em segredos.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_PATH=./data/relatorio.sqlite
APP_ORIGIN=http://localhost:5173
AI_PROVIDER=fake
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
